<Project>
  <!-- Single version source for the Windows application and packaging.
       AssemblyVersion keeps assembly identity stable while FileVersion and
       InformationalVersion show the release version (v1.0.0 => 1.0.0.0). -->
  <PropertyGroup>
    <KeepassityVersion Condition="'$(KeepassityVersion)' == ''">1.0.0</KeepassityVersion>
    <Version>$(KeepassityVersion)</Version>
    <InformationalVersion>$(KeepassityVersion)</InformationalVersion>
    <AssemblyVersion>$(KeepassityVersion).0</AssemblyVersion>
    <FileVersion>$(KeepassityVersion).0</FileVersion>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- The library projects are restored through the app and the test
         harnesses; their package graph is already pinned by those lock files.
         Their own empty/duplicated lock files used to flip between a RID and a
         non-RID restore, which left the repository dirty after every publish. -->
    <RestorePackagesWithLockFile
      Condition="'$(MSBuildProjectName)' == 'Keepassity.Core' or '$(MSBuildProjectName)' == 'Keepassity.ViewModels'">false</RestorePackagesWithLockFile>
    <NuGetLockFilePath Condition="'$(NuGetLockFilePath)' == ''">$(MSBuildProjectDirectory)\packages.lock.json</NuGetLockFilePath>
  </PropertyGroup>
</Project>
