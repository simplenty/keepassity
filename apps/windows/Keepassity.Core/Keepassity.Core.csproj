<Project Sdk="Microsoft.NET.Sdk">
  <!-- Platform-neutral application services shared by the Windows shell (and a
       future Linux shell): paths, settings, sync state, WebDAV, backups and
       diagnostics. No WinUI or other UI dependency belongs here. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Keepassity.Core</RootNamespace>
    <AssemblyName>Keepassity.Core</AssemblyName>
  </PropertyGroup>
  <!-- UI language catalogs: <domain>.<language>.json, embedded so the shell can
       switch languages at runtime without a PRI/resource-context reload. -->
  <ItemGroup>
    <EmbeddedResource Include="Localization\*.zh-CN.json" WithCulture="false" />
  </ItemGroup>
  <!-- The headless tests exercise the filesystem fallbacks (for example the
       replace path used on volumes without File.Replace) directly. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Keepassity.Core.Tests" />
  </ItemGroup>
</Project>
