<UserControl
    x:Class="Keepassity.App.SettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Keepassity.App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <StackPanel Spacing="14" Padding="0,0,8,0">
            <RadioButtons x:Name="ThemeChoices" SelectionChanged="ThemeChoices_SelectionChanged" />
            <ComboBox x:Name="LanguageCombo" MinWidth="160"
                      AutomationProperties.AutomationId="SettingsLanguageCombo"
                      SelectionChanged="LanguageCombo_SelectionChanged" />
            <ToggleSwitch x:Name="ClipboardToggle"
                          IsOn="{x:Bind ViewModel.ClearClipboardAfter30Seconds, Mode=TwoWay}" />
            <ToggleSwitch x:Name="AutoLockToggle"
                          IsOn="{x:Bind ViewModel.AutoLockEnabled, Mode=TwoWay}" />
            <ToggleSwitch x:Name="StartMinimizedToggle"
                          IsOn="{x:Bind ViewModel.StartMinimized, Mode=TwoWay}" />
            <NumberBox x:Name="AutoLockMinutesBox"
                       Value="{x:Bind ViewModel.AutoLockMinutes, Mode=TwoWay}"
                       Minimum="1" Maximum="240"
                       SpinButtonPlacementMode="Inline" />
            <NumberBox x:Name="RetentionBox"
                       Value="{x:Bind ViewModel.BackupRetention, Mode=TwoWay}"
                       Minimum="1" Maximum="200"
                       SpinButtonPlacementMode="Inline" />
            <TextBlock loc:LocMarkup.Text="WebDAV" FontWeight="SemiBold"
                       Margin="0,8,0,0" />
            <TextBox x:Name="WebDavUrlBox"
                     Text="{x:Bind ViewModel.WebDavUrl, Mode=TwoWay}"
                     PlaceholderText="https://dav.example.com/keepassity.kdbx"
                     IsReadOnly="{x:Bind ViewModel.IsWebDavSource}" />
            <TextBox x:Name="WebDavUserBox"
                     Text="{x:Bind ViewModel.WebDavUsername, Mode=TwoWay}"
                     IsReadOnly="{x:Bind ViewModel.IsWebDavSource}" />
            <PasswordBox x:Name="WebDavPasswordBox"
                         PasswordRevealMode="Peek" />
            <TextBlock Text="{x:Bind ViewModel.NextcloudNote}"
                       FontSize="11" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="{x:Bind ViewModel.StoredPasswordText, Mode=OneWay}"
                       FontSize="11" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button x:Name="ClearStoredPasswordButton"
                    Click="ClearStoredPassword_Click"
                    IsEnabled="{x:Bind ViewModel.CanClearStoredPassword, Mode=OneWay}"
                    HorizontalAlignment="Left" />
            <ToggleSwitch x:Name="SyncOnSaveToggle"
                          IsOn="{x:Bind ViewModel.SyncOnSave, Mode=TwoWay}" />
            <TextBlock Text="{x:Bind ViewModel.WebDavNote}"
                       FontSize="11" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <Image x:Name="AboutIcon" Width="72" Height="72"
                   HorizontalAlignment="Left" Margin="0,8,0,0"
                   Visibility="Collapsed" />
            <TextBlock loc:LocMarkup.Text="About" FontWeight="SemiBold"
                       Margin="0,8,0,0" />
            <TextBlock Text="{x:Bind ViewModel.AboutVersionLine}"
                       FontSize="11" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock loc:LocMarkup.Text="License: GNU General Public License, version 3 or later (GPL-3.0-or-later)."
                       FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind ViewModel.LicenseBody}"
                       FontSize="10" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <HyperlinkButton x:Name="LicenseLink"
                                 NavigateUri="https://www.gnu.org/licenses/gpl-3.0.html"
                                 Padding="0" FontSize="11" />
                <HyperlinkButton x:Name="SourceLink"
                                 NavigateUri="https://github.com/simplenty/keepassity"
                                 Padding="0" FontSize="11" />
            </StackPanel>
            <Button x:Name="DiagnosticsButton"
                    Click="Diagnostics_Click"
                    HorizontalAlignment="Left" />
        </StackPanel>
</UserControl>
