<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0</InformationalVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Keepassity.Mock</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>
  <!-- The native FFI DLL is produced by building the Rust ffi crate in release mode.
       Copy it next to the managed output for local runs, and into the publish output.
       `dotnet publish` also drops the XAML .xbf files that WinUI needs at startup, so the
       publish target copies both; a publish missing either is treated as an error instead
       of silently producing a package that cannot start or open a database. -->
  <PropertyGroup>
    <FfiNativeDir>$(MSBuildThisFileDirectory)..\..\..\target\release\</FfiNativeDir>
  </PropertyGroup>
  <Target Name="CopyFfiNativeOnBuild" AfterTargets="Build">
    <ItemGroup>
      <FfiBuildNative Include="$(FfiNativeDir)keepassity_ffi.dll" Condition="Exists('$(FfiNativeDir)keepassity_ffi.dll')" />
      <FfiBuildNative Include="$(FfiNativeDir)keepassity_ffi.pdb" Condition="Exists('$(FfiNativeDir)keepassity_ffi.pdb')" />
    </ItemGroup>
    <Copy SourceFiles="@(FfiBuildNative)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyNativeAndXamlToPublish" AfterTargets="Publish">
    <ItemGroup>
      <FfiPublishNative Include="$(FfiNativeDir)keepassity_ffi.dll" Condition="Exists('$(FfiNativeDir)keepassity_ffi.dll')" />
      <FfiPublishNative Include="$(FfiNativeDir)keepassity_ffi.pdb" Condition="Exists('$(FfiNativeDir)keepassity_ffi.pdb')" />
      <XamlPublishFiles Include="$(OutDir)**\*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="@(FfiPublishNative)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(XamlPublishFiles)" DestinationFiles="@(XamlPublishFiles->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Error Condition="!Exists('$(PublishDir)keepassity_ffi.dll')" Text="keepassity_ffi.dll is missing from the publish output ($(PublishDir)). Build it first: cargo build -p keepassity-ffi --release" />
    <Error Condition="'@(XamlPublishFiles)' == ''" Text="XAML resources (*.xbf) were not found under $(OutDir); the published app would fail to start." />
  </Target>
</Project>
