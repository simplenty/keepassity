<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Keepassity.Mock.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Keepassity.Mock"
    xmlns:loc="using:Keepassity.Mock"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Keepassity">

    <!-- AllowDrop + the handlers enable dragging a .kdbx file from Explorer onto
         the window. Internal entry drags carry text, not StorageItems, so they
         keep flowing to the group drop targets. -->
    <Grid x:Name="Root" Background="Transparent" AllowDrop="True"
          DragOver="Root_DragOver" Drop="Root_Drop">
        <Grid.Resources>
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="FieldValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style x:Key="SectionLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="ToolbarButton" TargetType="Button">
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="DangerToolbarButton" TargetType="Button"
                   BasedOn="{StaticResource ToolbarButton}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>
            <Style x:Key="EntryListItemStyle" TargetType="ListViewItem"
                   BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="MinHeight" Value="52" />
                <Setter Property="Margin" Value="4,2" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <ListViewItemPresenter
                                x:Name="Root"
                                ContentTransitions="{TemplateBinding ContentTransitions}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Control.IsTemplateFocusTarget="True"
                                FocusVisualMargin="{TemplateBinding FocusVisualMargin}"
                                FocusVisualPrimaryBrush="{TemplateBinding FocusVisualPrimaryBrush}"
                                FocusVisualPrimaryThickness="{TemplateBinding FocusVisualPrimaryThickness}"
                                FocusVisualSecondaryBrush="{TemplateBinding FocusVisualSecondaryBrush}"
                                FocusVisualSecondaryThickness="{TemplateBinding FocusVisualSecondaryThickness}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                ContentMargin="{TemplateBinding Padding}"
                                PointerOverBackground="{ThemeResource ListViewItemBackgroundPointerOver}"
                                PointerOverForeground="{ThemeResource ListViewItemForegroundPointerOver}"
                                SelectedBackground="{ThemeResource ListViewItemBackgroundSelected}"
                                SelectedForeground="{ThemeResource ListViewItemForegroundSelected}"
                                SelectedPointerOverBackground="{ThemeResource ListViewItemBackgroundSelectedPointerOver}"
                                PressedBackground="{ThemeResource ListViewItemBackgroundPressed}"
                                SelectedPressedBackground="{ThemeResource ListViewItemBackgroundSelectedPressed}"
                                DisabledOpacity="{ThemeResource ListViewItemDisabledThemeOpacity}"
                                CornerRadius="10"
                                CheckMode="{ThemeResource ListViewItemCheckMode}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Integrated title bar (window chrome + search in one surface). -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,0,0"
              Background="Transparent">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button x:Name="HamburgerButton" Style="{StaticResource IconButton}"
                            Visibility="Collapsed"
                            Click="HamburgerButton_Click"
                            IsDoubleTapEnabled="True"
                            DoubleTapped="TitleBarButton_DoubleTapped"
                            loc:LocMarkup.ToolTip="Toggle navigation"
                            loc:LocMarkup.Name="Toggle navigation"
                            AutomationProperties.AutomationId="NavigationToggle">
                        <FontIcon Glyph="&#xE700;" FontSize="14" />
                    </Button>
                    <Border Width="26" Height="26" CornerRadius="6" Margin="4,0,0,0"
                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                        <FontIcon Glyph="&#xE72E;" FontSize="13"
                                  Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                    <TextBlock Text="Keepassity" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="2,0,0,0" />
                </StackPanel>

                <!-- Only this middle strip is a window drag region. The left
                     buttons stay client content so double-clicking the
                     hamburger cannot maximize or restore the window. -->
                <Border x:Name="TitleBarDragArea" Grid.Column="1"
                        Background="Transparent" />
                <AutoSuggestBox x:Name="SearchBox" Grid.Column="1" Width="360"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                loc:LocMarkup.Text="Search" TextChanged="SearchBox_TextChanged"
                                loc:LocMarkup.Name="Search entries"
                                AutomationProperties.AutomationId="SearchBox"
                                loc:LocMarkup.HelpText="Search the open database (Ctrl+F)">
                    <AutoSuggestBox.QueryIcon>
                        <FontIcon Glyph="&#xE721;" />
                    </AutoSuggestBox.QueryIcon>
                </AutoSuggestBox>
            </Grid>
        </Grid>

        <Grid Grid.Row="1">
            <!-- Unlock or first-run start page. -->
            <Grid x:Name="UnlockRoot">
                <StackPanel Width="380" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="UnlockTitle" Text="Keepassity"
                               FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="UnlockStartHint"
                               loc:LocMarkup.Text="Open a local .kdbx file, connect to WebDAV, or create a new database."
                               FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="DatabasePathText" Text="No database selected"
                               HorizontalAlignment="Left" TextTrimming="CharacterEllipsis"
                               MaxWidth="380" Margin="0,4,0,0" Visibility="Collapsed"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                    <!-- Recent databases: local paths only, never vault content or
                         passwords. Shown on the start page when there is no current
                         database selected. -->
                    <StackPanel x:Name="RecentDatabasesSection" Visibility="Collapsed"
                                Margin="0,18,0,0"
                                loc:LocMarkup.Name="Recent databases"
                                AutomationProperties.AutomationId="RecentDatabases">
                        <TextBlock loc:LocMarkup.Text="Recent databases" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel x:Name="RecentDatabasesPanel" Spacing="6"
                                    Margin="0,8,0,0" />
                    </StackPanel>

                    <!-- Only shown when there is a database to unlock. -->
                    <StackPanel x:Name="UnlockFormSection" Visibility="Collapsed">
                        <InfoBar x:Name="UnlockError"
                                 IsOpen="{x:Bind Unlock.IsStatusOpen, Mode=OneWay}"
                                 Severity="{x:Bind ToInfoBarSeverity(Unlock.StatusSeverity), Mode=OneWay}"
                                 Title="{x:Bind Unlock.StatusTitle, Mode=OneWay}"
                                 Message="{x:Bind Unlock.StatusMessage, Mode=OneWay}"
                                 IsClosable="False"
                                 Margin="0,12,0,0"
                                 loc:LocMarkup.Name="Unlock status"
                                 AutomationProperties.AutomationId="UnlockStatus"
                                 AutomationProperties.LiveSetting="Polite" />
                        <!-- Recovery entry points shown after an unlock failure: a
                             diagnostics export and the backup folder location. -->
                        <StackPanel x:Name="UnlockFailureActions" Spacing="10"
                                    Margin="0,12,0,0"
                                    Visibility="{x:Bind ToVisibility(Unlock.RecoveryVisible), Mode=OneWay}">
                            <TextBlock x:Name="UnlockFailureHint" FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock x:Name="UnlockBackupPathText" FontSize="11"
                                       IsTextSelectionEnabled="True" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="UnlockDiagnosticsButton"
                                        Style="{StaticResource ToolbarButton}"
                                        loc:LocMarkup.ToolTip="Export logs and settings (no secrets)"
                                        loc:LocMarkup.Name="Export diagnostics"
                                        AutomationProperties.AutomationId="UnlockDiagnosticsButton"
                                        Click="UnlockDiagnosticsButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE74E;" FontSize="12" />
                                        <TextBlock loc:LocMarkup.Text="Export diagnostics" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="UnlockBackupFolderButton"
                                        Style="{StaticResource ToolbarButton}"
                                        loc:LocMarkup.ToolTip="Open the folder with timestamped database backups"
                                        loc:LocMarkup.Name="Open backup folder"
                                        AutomationProperties.AutomationId="UnlockBackupFolderButton"
                                        Click="UnlockBackupFolderButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="12" />
                                        <TextBlock loc:LocMarkup.Text="Backup folder" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Spacing="6" Margin="0,20,0,0">
                            <TextBlock loc:LocMarkup.Text="Master password" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <PasswordBox x:Name="MasterPassword" loc:LocMarkup.Text="Password"
                                         PasswordRevealMode="Peek"
                                         IsEnabled="{x:Bind Unlock.IsInputEnabled, Mode=OneWay}"
                                         loc:LocMarkup.Name="Master password"
                                         AutomationProperties.AutomationId="MasterPassword"
                                         KeyDown="MasterPassword_KeyDown" />
                        </StackPanel>
                        <Button x:Name="UnlockButton" HorizontalAlignment="Stretch" Height="36"
                                Margin="0,16,0,0"
                                Style="{StaticResource AccentButtonStyle}"
                                IsEnabled="{x:Bind Unlock.CanUnlock, Mode=OneWay}"
                                loc:LocMarkup.Name="Unlock database"
                                AutomationProperties.AutomationId="UnlockButton"
                                Click="UnlockButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72E;" FontSize="14" />
                                <TextBlock loc:LocMarkup.Text="Unlock" />
                            </StackPanel>
                        </Button>
                        <ProgressRing x:Name="UnlockProgress"
                                      IsActive="{x:Bind Unlock.IsBusy, Mode=OneWay}"
                                      Width="22" Height="22" HorizontalAlignment="Center"
                                      Margin="0,12,0,0"
                                      loc:LocMarkup.Name="Unlocking database" />
                    </StackPanel>

                    <!-- Database source actions are a separate concern from Unlock. -->
                    <Border x:Name="UnlockDivider" Height="1" Margin="0,24,0,20"
                            Visibility="Collapsed"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <TextBlock x:Name="DatabaseActionsLabel" loc:LocMarkup.Text="Open or create a database"
                               FontSize="12" FontWeight="SemiBold" Visibility="Collapsed"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Spacing="8" Margin="0,10,0,0">
                        <Button x:Name="ChooseDatabaseButton"
                                Style="{StaticResource ToolbarButton}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                MinHeight="36"
                                loc:LocMarkup.Name="Open local database file"
                                AutomationProperties.AutomationId="OpenLocalDatabaseButton"
                                Click="ChooseDatabaseButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8B7;" FontSize="13" />
                                <TextBlock loc:LocMarkup.Text="Open local file…" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="OpenFromWebDavButton"
                                Style="{StaticResource ToolbarButton}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                MinHeight="36"
                                loc:LocMarkup.Name="Open database from WebDAV"
                                AutomationProperties.AutomationId="OpenWebDavDatabaseButton"
                                Click="OpenFromWebDavButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE753;" FontSize="13" />
                                <TextBlock loc:LocMarkup.Text="Open from WebDAV…" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NewDatabaseButton"
                                Style="{StaticResource ToolbarButton}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                MinHeight="36"
                                loc:LocMarkup.Name="Create new database"
                                AutomationProperties.AutomationId="NewDatabaseButton"
                                Click="NewDatabaseButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="13" />
                                <TextBlock loc:LocMarkup.Text="New database…" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock loc:LocMarkup.Text="Local files are read and written through the Keepassity core. Databases opened from WebDAV keep a local working copy and sync back on save."
                               FontSize="11" TextWrapping="Wrap" Margin="0,16,0,0"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <!-- The language switch is also available before unlocking, so a
                         user whose Windows display language differs from what they
                         want to use can switch without opening the vault. -->
                    <StackPanel x:Name="UnlockLanguageSection" Orientation="Horizontal"
                                Spacing="8" Margin="0,18,0,0"
                                HorizontalAlignment="Left">
                        <FontIcon Glyph="&#xE774;" FontSize="13"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock loc:LocMarkup.Text="Language" FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <ComboBox x:Name="UnlockLanguageCombo" MinWidth="170" FontSize="11"
                                  AutomationProperties.AutomationId="UnlockLanguageCombo" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Main: permanent WinUI NavigationView pane + floating two-column workspace. -->
            <Grid x:Name="MainRoot" Visibility="Collapsed">
                <NavigationView x:Name="NavView"
                                PaneDisplayMode="Left"
                                IsPaneOpen="True"
                                IsPaneToggleButtonVisible="False"
                                IsBackButtonVisible="Collapsed"
                                IsSettingsVisible="False"
                                OpenPaneLength="232"
                                Background="Transparent"
                                loc:LocMarkup.Name="Database navigation"
                                AutomationProperties.AutomationId="MainNavigation"
                                SelectionChanged="NavView_SelectionChanged"
                                ItemInvoked="NavView_ItemInvoked">
                    <NavigationView.Resources>
                        <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                        <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
                        <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                    </NavigationView.Resources>

                    <NavigationView.PaneHeader>
                        <TextBlock x:Name="VaultNameText" Text="Personal.kdbx" FontSize="13" FontWeight="SemiBold"
                                   Margin="16,12,0,10" />
                    </NavigationView.PaneHeader>

                    <NavigationView.FooterMenuItems>
                        <NavigationViewItem x:Name="SyncNavItem" Content="Local only" Tag="sync" UseSystemFocusVisuals="False"
                                            SelectsOnInvoked="False"
                                            loc:LocMarkup.Name="Sync status"
                                            AutomationProperties.AutomationId="SyncStatus"
                                            loc:LocMarkup.HelpText="Shows the last sync result; invokes a sync now"
                                            AutomationProperties.LiveSetting="Polite">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE895;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem loc:LocMarkup.Text="Backups" Tag="backups" SelectsOnInvoked="False" UseSystemFocusVisuals="False"
                                            loc:LocMarkup.Name="Backups"
                                            AutomationProperties.AutomationId="BackupsNavigationItem">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE777;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem loc:LocMarkup.Text="Lock" Tag="lock" SelectsOnInvoked="False" UseSystemFocusVisuals="False"
                                            loc:LocMarkup.Name="Lock vault"
                                            AutomationProperties.AutomationId="LockNavigationItem"
                                            loc:LocMarkup.HelpText="Locks the vault immediately (Ctrl+L)">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE72E;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem x:Name="SettingsNavItem" loc:LocMarkup.Text="Settings" Tag="settings" SelectsOnInvoked="False" UseSystemFocusVisuals="False"
                                            loc:LocMarkup.Name="Settings"
                                            AutomationProperties.AutomationId="SettingsNavigationItem">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE713;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationView.FooterMenuItems>

                    <NavigationView.Content>
                        <!-- The workspace lives inside the NavigationView content
                             area so the pane and content share one layout instead
                             of two independently positioned overlays. -->
                        <Grid x:Name="WorkspaceHost">
                    <!-- The workspace owns its frame: rounded top-left only; right
                         and bottom are square and sit on the window edge. The top
                         and left hairlines wrap the rounded corner (the same
                         1,1,0,0 frame NavigationView draws for its content grid);
                         with only the top side stroked the corner would end in a
                         dangling hook and the pane/content seam would have no line. -->
                    <Border x:Name="WorkspaceFrame" Margin="0" CornerRadius="8,0,0,0"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1,1,0,0">
                        <Grid x:Name="WorkspacePanel">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="340" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- entry list -->
                            <Grid x:Name="EntryColumn" Grid.Column="0" Padding="16,14,12,12"
                                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                  BorderThickness="0,0,1,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Margin="0,0,0,10" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="1" Margin="0,0,8,0">
                                        <TextBlock x:Name="CurrentGroupTitle" Text="All entries"
                                                   FontSize="18" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="EntryCountText" Text="12 entries" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                VerticalAlignment="Center">
                                        <Button x:Name="ListOptionsButton"
                                                Style="{StaticResource ToolbarButton}"
                                                loc:LocMarkup.ToolTip="Sort and filter"
                                                loc:LocMarkup.Name="Sort and filter entries"
                                                AutomationProperties.AutomationId="ListOptionsButton"
                                                Click="ListOptionsButton_Click">
                                            <FontIcon Glyph="&#xE8CB;" FontSize="12" />
                                        </Button>
                                        <Button x:Name="NewEntryButton"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Padding="12,4" FontSize="12"
                                                loc:LocMarkup.Name="New entry"
                                                AutomationProperties.AutomationId="NewEntryButton"
                                                Click="NewEntryButton_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE710;" FontSize="12" />
                                                <TextBlock loc:LocMarkup.Text="New" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Border Grid.Row="1" Height="1"
                                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                        Margin="0,0,0,4" />

                                <ListView x:Name="EntryList" Grid.Row="2" SelectionMode="Single"
                                          SelectionChanged="EntryList_SelectionChanged"
                                          RightTapped="EntryList_RightTapped"
                                          CanDragItems="True"
                                          CanReorderItems="False"
                                          DragItemsStarting="EntryList_DragItemsStarting"
                                          DragItemsCompleted="EntryList_DragItemsCompleted"
                                          ItemContainerStyle="{StaticResource EntryListItemStyle}"
                                          Background="Transparent" Padding="2,4,8,0"
                                          loc:LocMarkup.Name="Entries"
                                          AutomationProperties.AutomationId="EntryList">
                                    <ListView.ItemContainerTransitions>
                                        <TransitionCollection>
                                            <AddDeleteThemeTransition />
                                            <RepositionThemeTransition />
                                        </TransitionCollection>
                                    </ListView.ItemContainerTransitions>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:EntryItem">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="36" Height="36" CornerRadius="18"
                                                        Background="{x:Bind AvatarBrush}">
                                                    <TextBlock Text="{x:Bind Initial}" FontSize="13"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="3"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Title}" FontSize="14"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind Secondary, Mode=OneWay}" FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Border Grid.Column="2" VerticalAlignment="Center"
                                                        Padding="7,3" CornerRadius="5"
                                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                        Visibility="{x:Bind TotpVisibility}">
                                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                                        <FontIcon Glyph="&#xE8D7;" FontSize="9"
                                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                        <TextBlock Text="TOTP" FontSize="9"
                                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <StackPanel x:Name="EmptyListState" Grid.Row="2"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Spacing="8" Visibility="Collapsed">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="32"
                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock loc:LocMarkup.Text="No entries here" FontSize="14" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" />
                                    <TextBlock x:Name="EmptyListHint" Text="Create the first entry with New."
                                               FontSize="11" HorizontalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>

                            <!-- detail -->
                            <Grid x:Name="DetailPane" Grid.Column="1" Padding="32,22,32,24"
                                  loc:LocMarkup.Name="Entry details"
                                  AutomationProperties.AutomationId="DetailPanel">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Margin="0,0,0,20" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="5" Margin="0,0,12,0">
                                        <TextBlock x:Name="DetailTitle" Text="GitHub" FontSize="22"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="DetailSubtitle" Text="github.com · Work" FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <Button Style="{StaticResource ToolbarButton}" Click="EditEntryButton_Click"
                                                loc:LocMarkup.Name="Edit entry"
                                                AutomationProperties.AutomationId="EditEntryButton">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE70F;" FontSize="12" />
                                                <TextBlock loc:LocMarkup.Text="Edit" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource DangerToolbarButton}" Click="DeleteEntryButton_Click"
                                                loc:LocMarkup.Name="Delete entry"
                                                AutomationProperties.AutomationId="DeleteEntryButton">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                                <TextBlock loc:LocMarkup.Text="Delete" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                                    <StackPanel Spacing="20">
                                        <!-- login fields -->
                                        <StackPanel Spacing="8">
                                            <TextBlock loc:LocMarkup.Text="Details" Style="{StaticResource SectionLabel}"
                                                       Margin="2,0,0,0" />
                                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1" CornerRadius="10" Padding="18,2">
                                                <StackPanel Spacing="0">
                                            <Grid x:Name="UsernameRow" ColumnSpacing="8" Padding="0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="96" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock loc:LocMarkup.Text="Username" Style="{StaticResource FieldLabel}" />
                                                <TextBlock x:Name="DetailUsername" Grid.Column="1"
                                                           Text="alex@example.com" Style="{StaticResource FieldValue}" />
                                                <Button Grid.Column="2" Style="{StaticResource IconButton}"
                                                        Click="CopyUsernameButton_Click"
                                                        loc:LocMarkup.ToolTip="Copy"
                                                        loc:LocMarkup.Name="Copy username"
                                                        loc:LocMarkup.HelpText="Copies the username to the clipboard"
                                                        AutomationProperties.AutomationId="CopyUsernameButton">
                                                    <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                                                </Button>
                                            </Grid>
                                            <Border x:Name="UsernameDivider" Height="1"
                                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                            <Grid x:Name="PasswordRow" ColumnSpacing="8" Padding="0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="96" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock loc:LocMarkup.Text="Password" Style="{StaticResource FieldLabel}" />
                                                <TextBlock x:Name="DetailPassword" Grid.Column="1"
                                                           Text="••••••••••••" Style="{StaticResource FieldValue}"
                                                           FontFamily="Consolas" />
                                                <Button x:Name="RevealPasswordButton" Grid.Column="2"
                                                        Style="{StaticResource IconButton}"
                                                        Click="RevealPasswordButton_Click"
                                                        loc:LocMarkup.ToolTip="Show"
                                                        loc:LocMarkup.Name="Show password"
                                                        loc:LocMarkup.HelpText="Reveals the password in this panel"
                                                        AutomationProperties.AutomationId="RevealPasswordButton">
                                                    <FontIcon Glyph="&#xE890;" FontSize="12" />
                                                </Button>
                                                <Button Grid.Column="3" Style="{StaticResource IconButton}"
                                                        Click="CopyPasswordButton_Click"
                                                        loc:LocMarkup.ToolTip="Copy"
                                                        loc:LocMarkup.Name="Copy password"
                                                        loc:LocMarkup.HelpText="Copies the password to the clipboard"
                                                        AutomationProperties.AutomationId="CopyPasswordButton">
                                                    <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                                                </Button>
                                            </Grid>
                                            <Border x:Name="PasswordDivider" Height="1"
                                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                            <Grid x:Name="UrlRow" ColumnSpacing="8" Padding="0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="96" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock loc:LocMarkup.Text="Website" Style="{StaticResource FieldLabel}" />
                                                <TextBlock x:Name="DetailUrl" Grid.Column="1"
                                                           Text="https://github.com" Style="{StaticResource FieldValue}" />
                                                <Button Grid.Column="2" Style="{StaticResource IconButton}"
                                                        Click="CopyUrlButton_Click"
                                                        loc:LocMarkup.ToolTip="Copy"
                                                        loc:LocMarkup.Name="Copy website"
                                                        loc:LocMarkup.HelpText="Copies the website URL to the clipboard"
                                                        AutomationProperties.AutomationId="CopyUrlButton">
                                                    <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                                                </Button>
                                                <Button Grid.Column="3" Style="{StaticResource IconButton}"
                                                        Click="OpenUrlButton_Click"
                                                        loc:LocMarkup.ToolTip="Open"
                                                        loc:LocMarkup.Name="Open website"
                                                        loc:LocMarkup.HelpText="Opens the website in the default browser"
                                                        AutomationProperties.AutomationId="OpenUrlButton">
                                                    <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                                                </Button>
                                            </Grid>
                                            <Border x:Name="UrlDivider" Height="1"
                                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                            <Grid x:Name="TagsRow" ColumnSpacing="8" Padding="0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="96" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock loc:LocMarkup.Text="Tags" Style="{StaticResource FieldLabel}" />
                                                <TextBlock x:Name="DetailTags" Grid.Column="1"
                                                           Text="work · developer · 2FA"
                                                           Style="{StaticResource FieldValue}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Grid>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- TOTP -->
                                        <Border x:Name="TotpDivider" Height="0"
                                                Background="Transparent" />
                                        <Border x:Name="TotpSection" Visibility="Collapsed"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1" CornerRadius="10" Padding="18,16">
                                            <Grid ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="6" Margin="0,0,12,0">
                                                    <TextBlock loc:LocMarkup.Text="One-time password" Style="{StaticResource SectionLabel}" />
                                                    <TextBlock x:Name="TotpCode" Text="—" FontSize="28"
                                                               FontWeight="SemiBold" FontFamily="Consolas"
                                                               CharacterSpacing="20"
                                                               TextTrimming="CharacterEllipsis"
                                                               loc:LocMarkup.Name="One-time password"
                                                               AutomationProperties.AutomationId="TotpCode"
                                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                    <TextBlock x:Name="TotpRemainingText" Text=""
                                                               FontSize="11"
                                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    <ProgressBar x:Name="TotpProgress" Height="4"
                                                                 CornerRadius="2"
                                                                 Minimum="0" Maximum="30" Value="0"
                                                                 Margin="0,8,0,0"
                                                                 HorizontalAlignment="Stretch" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="6"
                                                            HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource ToolbarButton}"
                                                            Click="CopyTotpButton_Click"
                                                            loc:LocMarkup.Name="Copy one-time password"
                                                            loc:LocMarkup.HelpText="Copies the currently displayed one-time password"
                                                            AutomationProperties.AutomationId="CopyTotpButton">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                                                            <TextBlock loc:LocMarkup.Text="Copy" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- custom fields -->
                                        <Border x:Name="CustomFieldsDivider" Height="0"
                                                Background="Transparent" />
                                        <Border x:Name="CustomFieldsSection" Visibility="Collapsed"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1" CornerRadius="10" Padding="18,16">
                                            <StackPanel Spacing="10">
                                                <TextBlock loc:LocMarkup.Text="Custom fields" Style="{StaticResource SectionLabel}" />
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="104" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="CustomFieldName" Text="Field"
                                                               Style="{StaticResource FieldLabel}"
                                                               FontSize="12" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock x:Name="CustomFieldValue" Grid.Column="1" Text=""
                                                               Style="{StaticResource FieldValue}" />
                                                    <Button Grid.Column="2" Style="{StaticResource IconButton}"
                                                            Click="CopyCustomFieldButton_Click"
                                                            loc:LocMarkup.ToolTip="Copy"
                                                            loc:LocMarkup.Name="Copy custom field"
                                                            loc:LocMarkup.HelpText="Copies the custom field value to the clipboard"
                                                            AutomationProperties.AutomationId="CopyCustomFieldButton">
                                                        <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- notes -->
                                        <Border x:Name="NotesDivider" Height="0"
                                                Background="Transparent" />
                                        <Border x:Name="NotesSection"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1" CornerRadius="10" Padding="18,16">
                                            <StackPanel Spacing="8">
                                                <TextBlock loc:LocMarkup.Text="Notes" Style="{StaticResource SectionLabel}" />
                                                <TextBlock x:Name="DetailNotes" TextWrapping="Wrap" FontSize="14"
                                                           LineHeight="21"
                                                           Text="Personal account. Recovery codes are stored in the off-line backup." />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                        </Grid>
                    </Border>
                </Grid>
                    </NavigationView.Content>
                </NavigationView>
            </Grid>
        </Grid>

        <InfoBar x:Name="Toast" Grid.Row="1" IsOpen="False" IsClosable="True" Severity="Success"
                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="0,0,20,20" Width="340"
                 loc:LocMarkup.Name="Status message"
                 AutomationProperties.AutomationId="StatusToast"
                 AutomationProperties.LiveSetting="Polite" />

        <!-- Screen-reader live region: announcements (unlock/save/sync/lock
             results) are written here and raised as a live-region change and a
             UIA notification so they are read even when the toast is visually
             too subtle to notice. Kept transparent and hit-test transparent
             rather than removed from the tree. -->
        <TextBlock x:Name="StatusAnnouncement" Grid.Row="1"
                   Width="1" Height="1" Opacity="0" IsHitTestVisible="False"
                   loc:LocMarkup.Name="Status"
                   AutomationProperties.AutomationId="StatusAnnouncement"
                   AutomationProperties.LiveSetting="Polite" />
    </Grid>
</Window>
