<Project Sdk="Microsoft.NET.Sdk">
  <!-- Self-contained WebDAV server used only by the M4-07 drills. It has no
       package references and no WinUI dependencies so it builds anywhere the
       .NET SDK is installed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MockWebDav</AssemblyName>
    <RootNamespace>Keepassity.Drills.MockWebDav</RootNamespace>
    <IsPackable>false</IsPackable>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>
</Project>
